{
  "name": "orb-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "orbs:server": "node tools/orbgen/server.mjs",
    "orbs:mcp": "node tools/orbgen/mcp.mjs",
    "orbs:install": "npm --prefix tools/orbgen install",
    "photos:build": "mkdir -p node_modules/.cache && swiftc -O tools/photo-library/build.swift -o node_modules/.cache/build-photo-library && node_modules/.cache/build-photo-library photo-library"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
